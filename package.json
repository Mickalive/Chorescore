{
  "name": "chorescore",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/clean-test-build.mjs && tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "functions:check": "npm --prefix functions run check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.17",
    "expo-constants": "57.0.15",
    "expo-router": "57.0.17",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.2",
    "expo-system-ui": "57.0.3",
    "firebase": "12.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  }
}
